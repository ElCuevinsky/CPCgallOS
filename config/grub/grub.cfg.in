if loadfont /boot/grub/font.pf2 ; then
  set gfxmode=auto
  insmod all_video
  terminal_output gfxterm
fi

search --no-floppy --set=root --file /casper/vmlinuz
set default=0
set timeout=15
set menu_color_normal=light-gray/black
set menu_color_highlight=black/light-gray

set superusers="root"
password_pbkdf2 root @GRUB_PASSWORD_HASH@

menuentry "CPCgallOS — Modo competencia (limpio)" --unrestricted {
  set gfxpayload=keep
  linux /casper/vmlinuz boot=casper toram nopersistent username=cpcgallos hostname=cpcgallos quiet splash ---
  initrd /casper/initrd
}

menuentry "CPCgallOS — Modo persistente (requiere root)" --users root {
  set gfxpayload=keep
  linux /casper/vmlinuz boot=casper toram persistent username=cpcgallos hostname=cpcgallos quiet splash ---
  initrd /casper/initrd
}
