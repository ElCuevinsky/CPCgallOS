#!/bin/sh
set -eu

user_assets="$HOME/CPCgallOS"
wallpaper="$user_assets/cpcgallos-wallpaper.png"
desktop_dir=$(xdg-user-dir DESKTOP 2>/dev/null || printf '%s\n' "$HOME/Desktop")
install -d -m 0755 "$user_assets/branding" "$user_assets/welcome" \
    "$user_assets/Plantillas" "$desktop_dir"
cp -a /usr/share/cpcgallos/branding/. "$user_assets/branding/"
cp -a /usr/share/cpcgallos/welcome/. "$user_assets/welcome/"
cp -a /usr/share/cpcgallos/templates/. "$user_assets/Plantillas/"
cp -a /usr/share/cpcgallos/desktop/. "$desktop_dir/"
install -m 0644 /usr/share/backgrounds/cpcgallos/cpcgallos-wallpaper.png \
    "$wallpaper"

# Chromium es un Snap en Xubuntu 26.04. Esta ruta de política pertenece al
# perfil del usuario y se crea después de que snapd haya preparado el entorno.
chromium_user_policy_dir="$HOME/snap/chromium/common/chromium/Default/policies/managed"
install -d -m 0755 "$chromium_user_policy_dir"
install -m 0644 /etc/chromium-browser/policies/managed/cpcgallos.json \
    "$chromium_user_policy_dir/cpcgallos.json"

set_wallpaper() {
    properties=$(xfconf-query -c xfce4-desktop -l 2>/dev/null || true)
    printf '%s\n' "$properties" | while IFS= read -r property; do
        case "$property" in
            */last-image)
                xfconf-query -c xfce4-desktop -p "$property" \
                    -s "$wallpaper" || true
                ;;
            */image-style)
                xfconf-query -c xfce4-desktop -p "$property" -s 5 || true
                ;;
        esac
    done

    xrandr --listmonitors 2>/dev/null | awk 'NR > 1 { print $NF }' \
        | while IFS= read -r monitor; do
            [ -n "$monitor" ] || continue
            prefix="/backdrop/screen0/monitor${monitor}/workspace0"
            xfconf-query -c xfce4-desktop -p "$prefix/last-image" \
                -n -t string -s "$wallpaper" 2>/dev/null || \
                xfconf-query -c xfce4-desktop -p "$prefix/last-image" \
                    -s "$wallpaper" || true
            xfconf-query -c xfce4-desktop -p "$prefix/image-style" \
                -n -t int -s 5 2>/dev/null || \
                xfconf-query -c xfce4-desktop -p "$prefix/image-style" \
                    -s 5 || true
        done
    xfdesktop --reload >/dev/null 2>&1 || true
}

set_wallpaper || true

if command -v snap >/dev/null 2>&1; then
    timeout 600 sh -c \
        'until snap list chromium >/dev/null 2>&1; do sleep 2; done' || true
fi

if [ -x /snap/bin/chromium ]; then
    exec /snap/bin/chromium "file://$user_assets/welcome/index.html"
fi

exit 0
