{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CPCgallOS: javac build",
      "type": "shell",
      "command": "/usr/bin/javac",
      "args": [
        "-d",
        "${workspaceFolder}/out",
        "${workspaceFolder}/Main.java"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$javac"]
    }
  ]
}
