{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CPCgallOS: python syntax check",
      "type": "shell",
      "command": "/usr/bin/python3",
      "args": ["-m", "py_compile", "${file}"],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
